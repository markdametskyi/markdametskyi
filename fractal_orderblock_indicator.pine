//@version=5
indicator("Fractal Order Block Indicator", overlay=true, max_boxes_count=500, max_lines_count=500)

// ==================== INPUTS ====================
// Timeframe selection
fractal_tf = input.timeframe("1H", "Fractal Timeframe", options=["15", "30", "1H", "4H", "1D", "1W", "1M"])
ob_tf = input.timeframe("1H", "Order Block Timeframe", options=["15", "30", "1H", "4H", "1D", "1W", "1M"])
target_tf = input.timeframe("1H", "Target Timeframe", options=["15", "30", "1H", "4H", "1D", "1W", "1M"])

// Fractal settings
fractal_type = input.string("5-bar", "Fractal Type", options=["3-bar", "5-bar"])
fractal_period = fractal_type == "3-bar" ? 1 : 2

// Statistics settings
stats_count = input.int(50, "Statistics Count", minval=10, maxval=200)
show_table = input.bool(true, "Show Statistics Table")

// Visual settings
ob_color = color.new(color.blue, 75) // 25% opacity blue
fractal_high_color = color.red
fractal_low_color = color.green
target_color = color.orange
ob_extension = 10

// ==================== VARIABLES ====================
var table info_table = na
var array<float> fractal_highs = array.new<float>()
var array<float> fractal_lows = array.new<float>()
var array<int> fractal_high_times = array.new<int>()
var array<int> fractal_low_times = array.new<int>()
var array<box> ob_boxes = array.new<box>()
var array<line> fractal_lines = array.new<line>()
var array<line> target_lines = array.new<line>()
var array<bool> ob_results = array.new<bool>()
var int total_setups = 0
var int successful_setups = 0

// ==================== FRACTAL DETECTION ====================
// Get data from different timeframes
fractal_high = request.security(syminfo.tickerid, fractal_tf, high)
fractal_low = request.security(syminfo.tickerid, fractal_tf, low)
fractal_open = request.security(syminfo.tickerid, fractal_tf, open)
fractal_close = request.security(syminfo.tickerid, fractal_tf, close)
fractal_time = request.security(syminfo.tickerid, fractal_tf, time)

// Get historical data for fractal detection
fractal_high_1 = request.security(syminfo.tickerid, fractal_tf, high[1])
fractal_high_2 = request.security(syminfo.tickerid, fractal_tf, high[2])

fractal_low_1 = request.security(syminfo.tickerid, fractal_tf, low[1])
fractal_low_2 = request.security(syminfo.tickerid, fractal_tf, low[2])

// Detect fractal highs and lows
is_fractal_high = false
is_fractal_low = false

// Check fractal high - only if we have enough historical data
if bar_index >= fractal_period + 1 and not na(fractal_high)
    if fractal_period == 1
        // 3-bar fractal - check previous bar
        is_fractal_high := fractal_high > fractal_high_1
    else
        // 5-bar fractal - check previous 2 bars
        is_fractal_high := fractal_high > fractal_high_1 and fractal_high > fractal_high_2

// Check fractal low - only if we have enough historical data
if bar_index >= fractal_period + 1 and not na(fractal_low)
    if fractal_period == 1
        // 3-bar fractal - check previous bar
        is_fractal_low := fractal_low < fractal_low_1
    else
        // 5-bar fractal - check previous 2 bars
        is_fractal_low := fractal_low < fractal_low_1 and fractal_low < fractal_low_2

// Store fractals
if is_fractal_high and not na(fractal_high)
    array.push(fractal_highs, fractal_high)
    array.push(fractal_high_times, fractal_time)
    if array.size(fractal_highs) > stats_count
        array.shift(fractal_highs)
        array.shift(fractal_high_times)

if is_fractal_low and not na(fractal_low)
    array.push(fractal_lows, fractal_low)
    array.push(fractal_low_times, fractal_time)
    if array.size(fractal_lows) > stats_count
        array.shift(fractal_lows)
        array.shift(fractal_low_times)

// ==================== ORDER BLOCK DETECTION ====================
// Get OB timeframe data
ob_high = request.security(syminfo.tickerid, ob_tf, high)
ob_low = request.security(syminfo.tickerid, ob_tf, low)
ob_open = request.security(syminfo.tickerid, ob_tf, open)
ob_close = request.security(syminfo.tickerid, ob_tf, close)
ob_time = request.security(syminfo.tickerid, ob_tf, time)

// Get previous bar data safely
ob_high_prev = request.security(syminfo.tickerid, ob_tf, high[1])
ob_low_prev = request.security(syminfo.tickerid, ob_tf, low[1])
ob_open_prev = request.security(syminfo.tickerid, ob_tf, open[1])
ob_close_prev = request.security(syminfo.tickerid, ob_tf, close[1])

// Check for Bullish Order Block (after fractal low)
if array.size(fractal_lows) > 0 and not na(ob_close_prev) and not na(ob_open_prev)
    fractal_low_level = array.get(fractal_lows, array.size(fractal_lows) - 1)
    fractal_low_time = array.get(fractal_low_times, array.size(fractal_low_times) - 1)
    
    // Check if we're in the context of the latest fractal low
    if ob_time >= fractal_low_time
        // Look for bearish candle followed by bullish candle
        if ob_close_prev < ob_open_prev and ob_close > ob_open and ob_open_prev > fractal_low_level
            // Check if low of either candle is below fractal low
            if ob_low_prev <= fractal_low_level or ob_low <= fractal_low_level
                // Create Bullish Order Block
                ob_box = box.new(left=ob_time - 60000, top=ob_high_prev, right=ob_time + ob_extension * 60000, bottom=ob_low_prev, bgcolor=ob_color, border_color=color.blue, border_width=2)
                array.push(ob_boxes, ob_box)
                
                // Find corresponding target (fractal high)
                float target_level = na
                for i = array.size(fractal_highs) - 1 to 0
                    if array.get(fractal_high_times, i) > fractal_low_time
                        target_level := array.get(fractal_highs, i)
                        break
                
                if not na(target_level)
                    // Create target line
                    target_line = line.new(x1=ob_time, y1=target_level, x2=ob_time + 100 * 60000, y2=target_level, color=target_color, width=2, style=line.style_dashed)
                    array.push(target_lines, target_line)
                    
                    // Start tracking this setup
                    total_setups += 1
                    array.push(ob_results, false)

// Check for Bearish Order Block (after fractal high)
if array.size(fractal_highs) > 0 and not na(ob_close_prev) and not na(ob_open_prev)
    fractal_high_level = array.get(fractal_highs, array.size(fractal_highs) - 1)
    fractal_high_time = array.get(fractal_high_times, array.size(fractal_high_times) - 1)
    
    // Check if we're in the context of the latest fractal high
    if ob_time >= fractal_high_time
        // Look for bullish candle followed by bearish candle
        if ob_close_prev > ob_open_prev and ob_close < ob_open and ob_open_prev < fractal_high_level
            // Check if high of either candle is above fractal high
            if ob_high_prev >= fractal_high_level or ob_high >= fractal_high_level
                // Create Bearish Order Block
                ob_box = box.new(left=ob_time - 60000, top=ob_high_prev, right=ob_time + ob_extension * 60000, bottom=ob_low_prev, bgcolor=ob_color, border_color=color.blue, border_width=2)
                array.push(ob_boxes, ob_box)
                
                // Find corresponding target (fractal low)
                float target_level = na
                for i = array.size(fractal_lows) - 1 to 0
                    if array.get(fractal_low_times, i) > fractal_high_time
                        target_level := array.get(fractal_lows, i)
                        break
                
                if not na(target_level)
                    // Create target line
                    target_line = line.new(x1=ob_time, y1=target_level, x2=ob_time + 100 * 60000, y2=target_level, color=target_color, width=2, style=line.style_dashed)
                    array.push(target_lines, target_line)
                    
                    // Start tracking this setup
                    total_setups += 1
                    array.push(ob_results, false)

// ==================== TARGET VALIDATION ====================
// Check if targets are reached without breaking OB levels
if array.size(ob_boxes) > 0 and array.size(ob_results) > 0
    for i = 0 to array.size(ob_boxes) - 1
        ob_box = array.get(ob_boxes, i)
        ob_result = array.get(ob_results, i)
        
        if not ob_result
            ob_left = box.get_left(ob_box)
            ob_right = box.get_right(ob_box)
            ob_top = box.get_top(ob_box)
            ob_bottom = box.get_bottom(ob_box)
            
            // Check if current time is within OB tracking period
            if time >= ob_left and time <= ob_right
                // Check for target line
                if i < array.size(target_lines)
                    target_line = array.get(target_lines, i)
                    target_y = line.get_y1(target_line)
                    
                    // Check if price reached target
                    if high >= target_y
                        // Check if OB level was not broken
                        ob_broken = false
                        if ob_bottom < ob_top // Bullish OB
                            if low <= ob_bottom
                                ob_broken := true
                        else // Bearish OB  
                            if high >= ob_top
                                ob_broken := true
                        
                        if not ob_broken
                            array.set(ob_results, i, true)
                            successful_setups += 1

// ==================== VISUALIZATION ====================
// Draw fractal lines
if array.size(fractal_highs) > 0
    for i = 0 to array.size(fractal_highs) - 1
        fractal_high = array.get(fractal_highs, i)
        fractal_time = array.get(fractal_high_times, i)
        
        fractal_line = line.new(x1=fractal_time, y1=fractal_high, x2=time + 50 * 60000, y2=fractal_high, color=fractal_high_color, width=1, style=line.style_solid)
        array.push(fractal_lines, fractal_line)

if array.size(fractal_lows) > 0
    for i = 0 to array.size(fractal_lows) - 1
        fractal_low = array.get(fractal_lows, i)
        fractal_time = array.get(fractal_low_times, i)
        
        fractal_line = line.new(x1=fractal_time, y1=fractal_low, x2=time + 50 * 60000, y2=fractal_low, color=fractal_low_color, width=1, style=line.style_solid)
        array.push(fractal_lines, fractal_line)

// ==================== STATISTICS TABLE ====================
if show_table and barstate.islast
    if na(info_table)
        info_table := table.new(position.top_right, 2, 4, bgcolor=color.white, border_width=1)
    
    // Calculate probability
    probability = total_setups > 0 ? (successful_setups / total_setups) * 100 : 0
    
    // Update table
    table.cell(info_table, 0, 0, "Setup", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 1, 0, "Probability", text_color=color.black, text_size=size.normal)
    table.cell(info_table, 0, 1, "POI: " + fractal_tf, text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 1, str.tostring(probability, "#.##") + "%", text_color=color.black, text_size=size.small)
    table.cell(info_table, 0, 2, "Confirmation: " + ob_tf, text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 2, str.tostring(successful_setups) + "/" + str.tostring(total_setups), text_color=color.black, text_size=size.small)
    table.cell(info_table, 0, 3, "Target: " + target_tf, text_color=color.black, text_size=size.small)
    table.cell(info_table, 1, 3, str.tostring(probability, "#.##") + "%", text_color=color.black, text_size=size.small)

// ==================== CLEANUP ====================
// Clean up old lines and boxes to prevent memory issues
if array.size(fractal_lines) > 100
    for i = 0 to 20
        if array.size(fractal_lines) > 0
            old_line = array.shift(fractal_lines)
            line.delete(old_line)

if array.size(ob_boxes) > 50
    for i = 0 to 10
        if array.size(ob_boxes) > 0
            old_box = array.shift(ob_boxes)
            box.delete(old_box)

if array.size(target_lines) > 50
    for i = 0 to 10
        if array.size(target_lines) > 0
            old_line = array.shift(target_lines)
            line.delete(old_line)